        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UEEtc.Wpf"
        mc:Ignorable="d"
        Title="UEEtc - Unreal Engine Experiments" Height="450" Width="800"
        MinHeight="240" MinWidth="400">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="UEEtc WPF" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Unreal Engine 関連の C# 実験アプリケーション"
