<Window x:Class="UEEtc.Wpf.Features.EventCounters.EventCountersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:UEEtc.Wpf.Preview"
        Title="UEEtc - イベントカウンター" Width="1280" Height="900" MinWidth="1000" MinHeight="720">
    <Grid Margin="20" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="イベントカウンター付与" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="解析して変更案を確認し、一覧のチェックで適用箇所を選びます。候補と数量ADDの推奨は推測です。意味を確認してください。" TextWrapping="Wrap" Margin="0,8,0,12" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="フォルダーを選択…" Click="Browse_Click" Padding="12,6" Margin="8,0,0,0" />
            <TextBox x:Name="SourcePath" TextChanged="SourceChanged" Padding="8" ToolTip="Source フォルダーのフルパス。フォルダーをドロップできます。" />
        </DockPanel>
        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <Button x:Name="AnalyzeButton" Content="解析・プレビュー" Click="Analyze_Click" Padding="14,7" Margin="0,0,8,0" />
            <Button x:Name="CancelButton" Content="中止" Click="Cancel_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0" />
            <Button x:Name="ExportButton" Content="レポートを保存…" Click="Export_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0" />
            <Button x:Name="ApplyButton" Content="元ファイルへ適用…" Click="Apply_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0" />
            <Button x:Name="PreviewButton" Content="プレビューを更新" Click="Preview_Click" IsEnabled="False" Padding="12,7" ToolTip="選択や設定の編集後は自動で更新します。" />
        </WrapPanel>
        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="検索" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="SelectVisibleButton" Content="表示中を選択" Click="SelectVisible_Click" Padding="8,4" Margin="8,0,0,0" />
                <Button x:Name="ClearVisibleButton" Content="表示中を解除" Click="ClearVisible_Click" Padding="8,4" Margin="8,0,0,0" />
            </StackPanel>
            <TextBox x:Name="FilterText" TextChanged="FilterChanged" Padding="6" ToolTip="パス・関数・条件・ヒントを検索。隠れた選択も適用対象です。" />
        </DockPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="400" MinWidth="280" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" MinWidth="400" /></Grid.ColumnDefinitions>
            <DataGrid x:Name="CandidateList" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                      SelectionChanged="CandidateSelected" EnableRowVirtualization="True" IsEnabled="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="適用" Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="ファイル" Binding="{Binding Candidate.RelativePath}" IsReadOnly="True" Width="170">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Candidate.RelativePath}" /></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="行" Binding="{Binding Candidate.Line}" IsReadOnly="True" Width="45" />
                    <DataGridTextColumn Header="条件" Binding="{Binding Candidate.Condition}" IsReadOnly="True" Width="140" />
                    <DataGridTextColumn Header="分岐" Binding="{Binding Candidate.Branch}" IsReadOnly="True" Width="50" />
                    <DataGridTextColumn Header="関数" Binding="{Binding Candidate.Function}" IsReadOnly="True" Width="180" />
                    <DataGridTextColumn Header="ヒント（要確認）" Binding="{Binding Candidate.Hint}" IsReadOnly="True" Width="130" />
                    <DataGridTextColumn Header="推奨ADD" Binding="{Binding Candidate.RecommendedQuantity.Value}" IsReadOnly="True" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" />
            <TabControl Grid.Column="2">
                <TabItem Header="付与後プレビュー"><preview:CodeChangePreview x:Name="PreviewText" /></TabItem>
                <TabItem Header="付与前"><TextBox x:Name="OriginalText" IsReadOnly="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" /></TabItem>
                <TabItem Header="候補の位置・数える内容"><TextBox x:Name="ContextText" IsReadOnly="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" /></TabItem>
                <TabItem x:Name="QuantityTab" Header="名前・数量ADD">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="QuantityEditor" Margin="10" DataContext="{Binding SelectedItem, ElementName=CandidateList}" IsEnabled="False">
                            <TextBlock Text="回数カウンターの識別子" /><TextBox Text="{Binding CounterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <TextBlock Text="Insights 表示名" /><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                            <Separator />
                            <TextBlock Text="別の累積数量を追加できます。現在個数や処理中件数は対象外です。推奨も実処理量とは限らないため、意味・単位を確認してください。" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <CheckBox Content="この候補に数量 ADD を追加" IsChecked="{Binding QuantityEnabled}" Margin="0,8" />
                            <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="数量の識別子" /><TextBox Text="{Binding QuantityName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <TextBlock Text="数量の表示名" /><TextBox Text="{Binding QuantityDisplay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <TextBlock Text="値（候補の値引数 または 0～4294967295 の十進整数）" TextWrapping="Wrap" />
                            <ComboBox x:Name="QuantityValueInput" IsEditable="True" ItemsSource="{Binding Candidate.AddValues}" Text="{Binding QuantityValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <TextBlock Text="単位（bytes / items 等）" /><TextBox Text="{Binding QuantityUnit, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <CheckBox Content="値の意味・単位・この分岐で加算する意味を確認した" IsChecked="{Binding MeaningConfirmed}" />
                            <TextBlock Text="適用の選択・数量の手入力・確認状態は復元しません。解析時には推奨を新しく提示します。値や単位を編集したら確認し直してください。" TextWrapping="Wrap" Margin="0,8" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="診断"><TextBox x:Name="DiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></TabItem>
            </TabControl>
        </Grid>
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Text="ソースフォルダーを指定して解析してください。" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
