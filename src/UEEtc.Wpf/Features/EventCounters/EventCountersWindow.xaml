<Window x:Class="UEEtc.Wpf.Features.EventCounters.EventCountersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:UEEtc.Wpf.Preview"
        Title="UEEtc - イベントカウンター" Width="1280" Height="900" MinWidth="1000" MinHeight="720">
    <Grid Margin="20" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="イベントカウンター付与" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="「解析・プレビュー」でADDとスコープDECREMENTの適切な箇所を自動設定します。追加内容と判断理由を確認し、適用するファイルを選んでください。" TextWrapping="Wrap" Margin="0,8,0,12" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="フォルダーを選択…" Click="Browse_Click" Padding="12,6" Margin="8,0,0,0" />
            <TextBox x:Name="SourcePath" TextChanged="SourceChanged" Padding="8" ToolTip="Source フォルダーのフルパス。フォルダーをドロップできます。" />
        </DockPanel>
        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <Button x:Name="AnalyzeButton" Content="解析・プレビュー" Click="Analyze_Click" Padding="14,7" Margin="0,0,8,0" />
            <Button x:Name="CancelButton" Content="中止" Click="Cancel_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0" />
            <Button x:Name="ExportButton" Content="レポートを保存…" Click="Export_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0" />
            <Button x:Name="ApplyButton" Content="元ファイルへ適用…" Click="Apply_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0" />
            <Button x:Name="PreviewButton" Content="プレビューを更新" Click="Preview_Click" IsEnabled="False" Padding="12,7" ToolTip="選択や設定の編集後は自動で更新します。" />
        </WrapPanel>
        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="検索" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="SelectAllButton" Content="全選択" Click="SelectAll_Click" Padding="8,4" Margin="8,0,0,0" />
                <Button x:Name="ClearAllButton" Content="全解除" Click="ClearAll_Click" Padding="8,4" Margin="8,0,0,0" />
                <Button x:Name="SelectRowsButton" Content="行を選択" Click="SelectRows_Click" Padding="8,4" Margin="8,0,0,0" ToolTip="強調表示した行を適用対象にします。Ctrl/Shiftで複数行、Spaceで切替。" />
                <Button x:Name="ClearRowsButton" Content="行を解除" Click="ClearRows_Click" Padding="8,4" Margin="8,0,0,0" />
                <Button x:Name="SelectVisibleButton" Content="表示中を選択" Click="SelectVisible_Click" Padding="8,4" Margin="8,0,0,0" />
                <Button x:Name="ClearVisibleButton" Content="表示中を解除" Click="ClearVisible_Click" Padding="8,4" Margin="8,0,0,0" />
            </StackPanel>
            <TextBox x:Name="FilterText" TextChanged="FilterChanged" Padding="6" ToolTip="パス・関数・条件・ヒントを検索。隠れた選択も適用対象です。" />
        </DockPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="510" MinWidth="420" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" MinWidth="400" /></Grid.ColumnDefinitions>
            <DataGrid x:Name="FileList" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
                      SelectionChanged="FileSelected" EnableRowVirtualization="True" IsEnabled="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="適用" Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinHeight="28" />
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="ファイル" Binding="{Binding RelativePath}" IsReadOnly="True" Width="*" MinWidth="200">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding RelativePath}" /></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="候補" Binding="{Binding CandidateCount}" IsReadOnly="True" Width="55" />
                    <DataGridTextColumn Binding="{Binding DecrementCount}" IsReadOnly="True" Width="105">
                        <DataGridTextColumn.Header><TextBlock Text="DECREMENT" ToolTip="含める候補へのDECREMENT付与予定数。適用ファイルのチェック状態には依存しません。" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding AddCount}" IsReadOnly="True" Width="55">
                        <DataGridTextColumn.Header><TextBlock Text="ADD" ToolTip="含める候補へのADD付与予定数。詳細設定が未完了の候補も含みます。" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" />
            <TabControl Grid.Column="2">
                <TabItem Header="付与後プレビュー">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" MaxHeight="160" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="PreviewSummary" TextWrapping="Wrap" Margin="8" /></ScrollViewer>
                        <preview:CodeChangePreview x:Name="PreviewText" Grid.Row="1" />
                    </Grid>
                </TabItem>
                <TabItem Header="付与前"><TextBox x:Name="OriginalText" IsReadOnly="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" /></TabItem>
                <TabItem Header="候補の位置・数える内容"><TextBox x:Name="ContextText" IsReadOnly="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" /></TabItem>
                <TabItem x:Name="QuantityTab" Header="候補・詳細設定">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="160" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DataGrid x:Name="CandidateList" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="CandidateSelected">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="含む" Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="28" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="行" Binding="{Binding Candidate.Line}" IsReadOnly="True" Width="45" />
                                <DataGridTextColumn Header="関数" Binding="{Binding Candidate.Function}" IsReadOnly="True" Width="170" />
                                <DataGridTextColumn Header="分岐" Binding="{Binding Candidate.Branch}" IsReadOnly="True" Width="55" />
                                <DataGridTextColumn Header="条件" Binding="{Binding Candidate.Condition}" IsReadOnly="True" Width="200" />
                                <DataGridTextColumn Header="付与するマクロ" Binding="{Binding PlannedMacros}" IsReadOnly="True" Width="300" />
                            </DataGrid.Columns>
                        </DataGrid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="QuantityEditor" Margin="10" DataContext="{Binding SelectedItem, ElementName=CandidateList}" IsEnabled="False">
                            <TextBlock Text="解析時に自動設定済みです。通常は付与後プレビューで変更内容を確認するだけで利用できます。" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding AutomaticDecision}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding PlannedMacros}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Expander x:Name="AdvancedOptions" Header="詳細設定（自動設定を変更する場合）" IsExpanded="False"><StackPanel Margin="0,10,0,0">
                            <CheckBox Content="累積回数とは別にスコープ現在数を追加（退出時にDECREMENT）" IsChecked="{Binding IncludeActiveScope}" Margin="0,0,0,8" />
                            <CheckBox Content="この分岐のスコープ現在数（退出時に DECREMENT）" IsChecked="{Binding TrackActiveScopes}" Margin="0,0,0,8" />
                            <TextBlock Text="標準は累積進入回数です。現在数はこの分岐の入口から退出までを数え、returnでも減少します。非同期要求やオブジェクトの生存数とは異なります。" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <TextBlock Text="回数カウンターの識別子" /><TextBox Text="{Binding CounterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <TextBlock Text="Insights 表示名" /><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                            <Separator />
                            <TextBlock Text="推奨は入力数量として自動追加します。成功量や実処理量ではありません。手入力した値・単位は意味を確認してください。現在個数は対象外です。" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <CheckBox Content="この候補に数量 ADD を追加" IsChecked="{Binding QuantityEnabled}" Margin="0,8" />
                            <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="数量の識別子" /><TextBox Text="{Binding QuantityName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <TextBlock Text="数量の表示名" /><TextBox Text="{Binding QuantityDisplay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <TextBlock Text="値（候補の値引数・Num() または 0～4294967295 の十進整数）" TextWrapping="Wrap" />
                            <ComboBox x:Name="QuantityValueInput" IsEditable="True" ItemsSource="{Binding Candidate.AddValues}" Text="{Binding QuantityValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <TextBlock Text="単位（bytes / items 等）" /><TextBox Text="{Binding QuantityUnit, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                            <CheckBox Content="値の意味・単位・この分岐で加算する意味を確認した" IsChecked="{Binding MeaningConfirmed}" />
                            <TextBlock Text="適用の選択・数量の手入力・確認状態は復元しません。解析時には推奨を新しく提示します。値や単位を編集したら確認し直してください。" TextWrapping="Wrap" Margin="0,8" />
                            </StackPanel></Expander>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="診断"><TextBox x:Name="DiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></TabItem>
            </TabControl>
        </Grid>
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Text="ソースフォルダーを指定して解析してください。" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
